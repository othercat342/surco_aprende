# Copiá este archivo como ".env" y completá tus datos. El archivo ".env" no se sube a GitHub.

# Chat con IA (Cuartetito): elegí uno
GEMINI_API_KEY=pegá_tu_clave_de_gemini
GEMINI_MODEL=gemini-3.1-flash-lite

# Sesiones (cualquier texto largo y aleatorio)
SESSION_SECRET=cambiame_por_un_texto_largo_y_aleatorio

# Ingreso con Google: el "ID de cliente" de Google Cloud Console (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
